{
  "name": "interprete-ps",
  "private": true,
  "version": "0.0.0",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:electron": "electron-builder --win nsis --x64",
    "build": "npm run build:web && npm run build:electron",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tensorflow/tfjs": "^4.22.0",
    "idb-keyval": "^6.2.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.5.0",
    "electron-builder": "^24.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.interptrte.ps",
    "productName": "InterPtrte PS",
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
